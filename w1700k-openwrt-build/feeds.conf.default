# ==========================================================================
#  OpenWrt feeds（会覆盖源码树里的 feeds.conf.default）
#  - 前 4 个是官方 feed，跟 main 分支配套
#  - 后面是第三方插件源
#  注意：单包仓库的 feed 名必须和包名一致，luci.mk 用目录名推导 PKG_NAME
# ==========================================================================

src-git packages https://git.openwrt.org/feed/packages.git
src-git luci https://git.openwrt.org/project/luci.git
src-git routing https://git.openwrt.org/feed/routing.git
src-git telephony https://git.openwrt.org/feed/telephony.git

# ---- Turbo ACC（流量分载 / BBR / 全锥 NAT）----
src-git turboacc https://github.com/chenmozhijin/turboacc.git

# ---- OpenClash ----
src-git openclash https://github.com/vernesong/OpenClash.git

# ---- Argon 主题 & 配置页 ----
src-git luci-theme-argon https://github.com/jerrykuku/luci-theme-argon.git
src-git luci-app-argon-config https://github.com/jerrykuku/luci-app-argon-config.git

# ---- Airoha 管理面板（NPU / CPU / Frame Engine），中文增强版 ----
# 上游原版：https://github.com/rchen14b/luci-app-airoha-npu.git
src-git luci-app-airoha-npu https://github.com/luanmuc/luci-app-airoha-npu.git

# ---- WiFi7 / MLO 管理页（MT7996）----
src-git luci-app-wifi7 https://github.com/woziwrt/luci-app-wifi7.git
