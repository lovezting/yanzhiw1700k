# ==========================================================================
#  基础配置：Gemtek W1700K（Airoha AN7581，OpenWrt U-Boot / UBI 布局）
#  用法：与 configs/features/*.conf 拼接成 .config，然后 make defconfig
#  设备只在 OpenWrt main 分支存在，因此本工程固定编译 main
# ==========================================================================

# ---------------- 目标平台 / 设备 ----------------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_w1700k-ubi=y

# ---------------- 镜像格式 ----------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ---------------- LuCI / Web 界面 ----------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ---------------- 中文界面 ----------------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ---------------- 无线（WiFi 7 / MT7996）----------------
# 设备自带 wpad-basic-mbedtls，已经带 802.11be(MLO) 支持，默认不动它。
# 需要 WPS / WPA-Enterprise 时，取消下面两行注释即可（Kconfig 会自动关掉冲突的 basic 变体）：
# CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_hostapd-utils=y

# ---------------- 系统工具 ----------------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_block-mount=y
