#!/bin/sh
# ==========================================================================
#  首次启动（或恢复出厂设置后）执行的默认设置
#  放在 files/ 下的内容会被原样合并进固件的根文件系统
# ==========================================================================

# 默认使用 Argon 主题 + 中文界面（主题没被打进去时自动跳过，避免 Web 打不开）
if [ -d /www/luci-static/argon ]; then
	uci -q set luci.main.mediaurlbase='/luci-static/argon'
fi
uci -q set luci.main.lang='zh_cn'
uci -q commit luci

# 默认打开 UPnP（不需要的话在 LuCI → 服务 → UPnP 里关掉，或删掉这三行）
uci -q set upnpd.config.enabled='1'
uci -q set upnpd.config.enable_natpmp='1'
uci -q commit upnpd

# Turbo ACC：默认打开软件流量分载 + BBR 拥塞控制
if [ -f /etc/config/turboacc ]; then
	uci -q set turboacc.config.sw_flow_offload='1'
	uci -q set turboacc.config.tcp_bbr_cca='1'
	uci -q commit turboacc
fi

exit 0
